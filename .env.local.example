# Upbo Vercel + Supabase Private Alpha
# Copy to .env.local for local testing. Set the same keys in Vercel Project Settings → Environment Variables.

# Required for Vercel API routes to talk to Supabase. Never expose this with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# sy-only admin token. Used by /api/admin/* and /api/s/:slug/settings.
UPBO_ADMIN_TOKEN=replace-with-long-random-admin-token

# Use this when applying the prefixed SQL in an existing Supabase project.
UPBO_TABLE_PREFIX=upbo_alpha_

# Optional. Server components use same-origin automatically on Vercel via VERCEL_URL.
# For local `npm run dev`, use this if you want pages to fetch this same Next API.
UPBO_API_BASE=http://127.0.0.1:3000

# Optional for browser-side forms when testing a non-same-origin API. Usually leave empty on Vercel.
# NEXT_PUBLIC_UPBO_API_BASE=
